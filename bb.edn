{:tasks
 {:requires ([babashka.curl :as curl]
             [babashka.fs :as fs]
             [babashka.process :as p]
             [clojure.edn :as edn]
             [clojure.string :as str])

  :init
  (do
    (def adjectives
      (str/split
       "admiring adoring affectionate agitated amazing awesome blissful bold brave clever cool dreamy eager ecstatic elegant epic focused friendly gifted goofy gracious happy hopeful hungry inspiring jolly kind laughing loving lucid magical modest mystifying nifty optimistic peaceful practical quirky relaxed reverent silly sleepy stoic trusting vibrant vigilant wizardly wonderful youthful zealous"
       (re-pattern "\\s+")))

    (def scientists
      (str/split
       "agnesi albattani allen archimedes banach bell benz borg bose boyd carson chandrasekhar curie darwin edison einstein euclid feynman galileo goldberg hawking heisenberg hopper hypatia jackson johnson khayyam liskov lovelace mclean mendeleev newton noether pasteur perlman pike poincare ritchey shannon tesla torvalds turing varahamihira volhard wright yonath"
       (re-pattern "\\s+")))

    (def option-specs
      {"--image"            {:key :image :env "IMAGE" :default "npm-bb" :value "NAME"
                             :doc "Docker image name"}
       "--tag"              {:key :tag :env "TAG" :default "dev" :value "TAG"
                             :doc "Docker image tag"}
       "--node-major"       {:key :node-major :env "NODE_MAJOR" :default "24" :value "MAJOR"
                             :doc "Node.js major version build arg"}
       "--no-cache"         {:key :no-cache? :boolean? true
                             :doc "Pass --no-cache to docker build"}
       "--user-id"          {:key :user-id :env "USER_ID" :value "UID"
                             :doc "Container user id build arg; defaults to `id -u`"}
       "--group-id"         {:key :group-id :env "GROUP_ID" :value "GID"
                             :doc "Container group id build arg; defaults to `id -g`"}
       "--project-dir"      {:key :project-dir :env "PROJECT_DIR" :value "PATH"
                             :doc "Project root; defaults to the current directory"}
       "--workdir"          {:key :workdir :env "WORKDIR" :default "/home/developer" :value "PATH"
                             :doc "Container working directory"}
       "--prefix"           {:key :prefix :env "PREFIX" :default "homes" :value "PATH"
                             :doc "Directory under project-dir for generated homes"}
       "--name"             {:key :name :env "DOCKER_STYLE_RANDOM_NAME" :value "NAME"
                             :doc "Container hostname/home name; defaults to a random Docker-style name"}
       "--hostname"         {:key :name :env "DOCKER_STYLE_RANDOM_NAME" :value "NAME"
                             :doc "Alias for --name"}
       "--project-subdir"   {:key :project-subdir :env "PROJECT_SUBDIR" :value "PATH"
                             :doc "Host directory mounted into the container"}
       "--docker-run-args"  {:key :docker-run-args :env "DOCKER_RUN_ARGS" :value "ARGS"
                             :doc "Raw shell fragment appended to `docker run` args"}
       "--docker-run-arg"   {:key :docker-run-arg :multi? true :value "ARG"
                             :doc "Single extra docker-run argument; repeat as needed"}
       "--skip-build"       {:key :skip-build? :boolean? true
                             :doc "For shell: skip the image build step"}
       "--dry-run"          {:key :dry-run? :boolean? true
                             :doc "Print commands without executing them"}
       "--all"              {:key :all? :boolean? true
                             :doc "For clean: delete the entire generated homes directory"}
       "--help"             {:key :help? :boolean? true
                             :doc "Print option help"}})

    (def option-aliases
      {"-i" "--image"
       "-t" "--tag"
       "-n" "--name"
       "-w" "--workdir"
       "-p" "--prefix"})

    (def option-order
      ["--image" "--tag" "--node-major" "--no-cache" "--user-id" "--group-id"
       "--project-dir" "--workdir" "--prefix" "--name" "--project-subdir"
       "--docker-run-args" "--docker-run-arg" "--skip-build" "--dry-run"
       "--all" "--help"])

    (def dockerfile-owner "bigconfig-ai")
    (def dockerfile-project "npm-bb")
    (def dockerfile-repo (str dockerfile-owner "/" dockerfile-project))
    (def dockerfile-dep 'io.github.bigconfig-ai/npm-bb)

    (defn blankish? [x]
      (or (nil? x) (and (string? x) (str/blank? x))))

    (defn env [k]
      (let [v (System/getenv k)]
        (when-not (blankish? v) v)))

    (defn first-value [& values]
      (first (remove blankish? values)))

    (defn random-name []
      (str (rand-nth adjectives) "-" (rand-nth scientists)))

    (defn command-out [& args]
      (str/trim (:out (apply p/shell {:out :string :err :inherit} args))))

    (defn sh-quote [x]
      (let [s (str x)]
        (if (re-matches (re-pattern "[A-Za-z0-9_@%+=:,./-]+") s)
          s
          (str "'" (str/replace s "'" "'\"'\"'") "'"))))

    (defn printable-command [args]
      (str/join " " (map sh-quote args)))

    (defn github-headers [accept]
      (cond-> {"user-agent" "@bigconfig/bb"
               "accept" accept
               "x-github-api-version" "2022-11-28"}
        (env "GITHUB_TOKEN") (assoc "authorization" (str "Bearer " (env "GITHUB_TOKEN")))))

    (defn slurp-github-file [owner project sha file]
      (let [url (str "https://api.github.com/repos/" owner "/" project
                     "/contents/" file "?ref=" sha)
            resp (curl/get url {:headers (github-headers "application/vnd.github.raw")
                                :throw false})
            status (:status resp)]
        (cond
          (= 200 status) (:body resp)
          (= 404 status) (throw (ex-info (str owner "/" project " has no " file
                                               " at " sha)
                                          {:repo (str owner "/" project)
                                           :sha sha
                                           :file file}))
          :else (throw (ex-info (str "GitHub API error " status " fetching " file
                                     " from " owner "/" project)
                                {:repo (str owner "/" project)
                                 :sha sha
                                 :file file
                                 :status status})))))

    (defn read-project-bb-edn [project-dir]
      (let [bb-edn (fs/path project-dir "bb.edn")]
        (when (fs/exists? bb-edn)
          (try
            (edn/read-string (slurp (str bb-edn)))
            (catch Exception _ nil)))))

    (defn dockerfile-sha-from-bb-edn [project-dir]
      (some-> (read-project-bb-edn project-dir)
              :deps
              (get dockerfile-dep)
              :git/sha))

    (defn dockerfile-sha-from-ls-remote []
      (try
        (let [out (command-out "git" "ls-remote"
                               (str "https://github.com/" dockerfile-repo ".git")
                               "HEAD")
              sha (first (str/split out (re-pattern "\\s+")))]
          (when-not (blankish? sha) sha))
        (catch Exception _ nil)))

    (defn dockerfile-pinned-sha [project-dir]
      (first-value (dockerfile-sha-from-bb-edn project-dir)
                   (env "BB_BOOTSTRAP_SHA")))

    (defn dockerfile-sha [project-dir]
      (first-value (dockerfile-pinned-sha project-dir)
                   (dockerfile-sha-from-ls-remote)))

    (defn short-sha [sha]
      (subs sha 0 (min 7 (count sha))))

    (defn ensure-trailing-newline [s]
      (if (str/ends-with? s "\n") s (str s "\n")))

    (defn ensure-dockerfile! [cfg]
      (let [target (fs/path (:project-dir cfg) "Dockerfile")]
        (when-not (fs/exists? target)
          (if (:dry-run? cfg)
            (println "+ download"
                     (str dockerfile-repo "/Dockerfile@"
                          (or (some-> (dockerfile-pinned-sha (:project-dir cfg)) short-sha)
                              "<resolved-sha>"))
                     "->"
                     (str target))
            (let [sha (dockerfile-sha (:project-dir cfg))]
              (when (blankish? sha)
                (throw (ex-info (str "Could not determine Dockerfile SHA for " dockerfile-repo)
                                {:repo dockerfile-repo
                                 :hint (str "Pass " dockerfile-repo
                                            " as the first argument to @bigconfig/bb so it injects a pinned dep, "
                                            "or install git so the repo HEAD can be resolved.")})))
              (println "+ download"
                       (str dockerfile-repo "/Dockerfile@" (short-sha sha))
                       "->"
                       (str target))
              (fs/create-dirs (fs/parent target))
              (spit (str target)
                    (ensure-trailing-newline
                     (slurp-github-file dockerfile-owner dockerfile-project sha "Dockerfile"))))))))

    (defn split-option [arg]
      (if-let [idx (str/index-of arg "=")]
        [(subs arg 0 idx) (subs arg (inc idx))]
        [arg nil]))

    (defn parse-bool [value]
      (if (nil? value)
        true
        (contains? #{"1" "true" "yes" "y" "on"}
                   (str/lower-case (str value)))))

    (defn add-option [opts spec value]
      (if (:multi? spec)
        (update opts (:key spec) (fnil conj []) value)
        (assoc opts (:key spec) value)))

    (defn parse-cli [args]
      (loop [args (seq args)
             opts {}]
        (if-not args
          opts
          (let [arg (first args)]
            (cond
              (= arg "--")
              (assoc opts :command (vec (rest args)))

              (or (str/starts-with? arg "--") (contains? option-aliases arg))
              (let [[raw-flag inline-value] (split-option arg)
                    flag (get option-aliases raw-flag raw-flag)
                    spec (get option-specs flag)]
                (when-not spec
                  (throw (ex-info (str "Unknown option: " raw-flag)
                                  {:option raw-flag})))
                (if (:boolean? spec)
                  (recur (next args)
                         (assoc opts (:key spec) (parse-bool inline-value)))
                  (let [inline? (some? inline-value)
                        value (if inline? inline-value (second args))]
                    (when (nil? value)
                      (throw (ex-info (str "Missing value for option: " raw-flag)
                                      {:option raw-flag})))
                    (recur (if inline? (next args) (nnext args))
                           (add-option opts spec value)))))

              :else
              (assoc opts :command (vec args)))))))

    (defn resolved-option [cli key env-name default]
      (first-value (get cli key) (some-> env-name env) default))

    (defn config [args]
      (let [cli (parse-cli args)]
        (when (:help? cli)
          (println "Usage: bb <task> [options] [-- command ...]")
          (println)
          (println "Examples:")
          (println "  bb shell")
          (println "  bb shell --image npm-bb --tag dev")
          (println "  bb shell --docker-run-arg=-p --docker-run-arg=3000:3000")
          (println "  bb shell --skip-build -- bash -lc 'node --version'")
          (println "  bb build --no-cache")
          (println "  IMAGE=my-image TAG=dev bb build")
          (println)
          (println "Options:")
          (doseq [flag option-order
                  :let [{:keys [value env default doc]} (get option-specs flag)
                        alias (some (fn [[short long]] (when (= long flag) short)) option-aliases)
                        names (str flag (when alias (str ", " alias)) (when value (str " " value)))
                        env-text (str/join ", " (remove blankish? [(when env (str "env " env))
                                                                    (when default (str "default " default))]))]]
            (println (format "  %-31s %s%s" names doc (if (str/blank? env-text) "" (str " (" env-text ")")))))
          (System/exit 0))
        (let [project-dir (str (fs/absolutize (resolved-option cli :project-dir "PROJECT_DIR" (str (fs/cwd)))))
              name (resolved-option cli :name "DOCKER_STYLE_RANDOM_NAME" (random-name))
              prefix (resolved-option cli :prefix "PREFIX" "homes")
              project-subdir-override (first-value (:project-subdir cli) (env "PROJECT_SUBDIR"))
              project-subdir (str (fs/absolutize
                                    (or project-subdir-override
                                        (str (fs/path project-dir prefix name)))))
              image (resolved-option cli :image "IMAGE" "npm-bb")
              tag (resolved-option cli :tag "TAG" "dev")
              docker-run-args (resolved-option cli :docker-run-args "DOCKER_RUN_ARGS" nil)
              cfg {:image image
                   :tag tag
                   :image-ref (str image ":" tag)
                   :node-major (resolved-option cli :node-major "NODE_MAJOR" "24")
                   :no-cache? (boolean (:no-cache? cli))
                   :user-id (resolved-option cli :user-id "USER_ID" (command-out "id" "-u"))
                   :group-id (resolved-option cli :group-id "GROUP_ID" (command-out "id" "-g"))
                   :project-dir project-dir
                   :workdir (resolved-option cli :workdir "WORKDIR" "/home/developer")
                   :prefix prefix
                   :name name
                   :project-subdir project-subdir
                   :project-subdir-explicit? (boolean project-subdir-override)
                   :docker-run-args docker-run-args
                   :docker-run-arg (vec (:docker-run-arg cli))
                   :command (or (seq (:command cli)) ["bash"])
                   :skip-build? (boolean (:skip-build? cli))
                   :dry-run? (boolean (:dry-run? cli))
                   :all? (boolean (:all? cli))}]
          (ensure-dockerfile! cfg)
          cfg)))

    (defn run-args! [cfg args]
      (println "+" (printable-command args))
      (when-not (:dry-run? cfg)
        (apply p/shell args)))

    (defn run-shell! [cfg command]
      (println "+" command)
      (when-not (:dry-run? cfg)
        (p/shell command)))

    (defn build! [cfg]
      (run-args!
       cfg
       (cond-> ["docker" "build"]
         (:no-cache? cfg) (conj "--no-cache")
         true (into ["--build-arg" (str "USER_ID=" (:user-id cfg))
                     "--build-arg" (str "GROUP_ID=" (:group-id cfg))
                     "--build-arg" (str "NODE_MAJOR=" (:node-major cfg))
                     "-t" (:image-ref cfg)
                     (:project-dir cfg)]))))

    (defn copy-agent-file! [cfg file-name]
      (let [source (fs/path (System/getProperty "user.home") ".pi" "agent" file-name)
            target-dir (fs/path (:project-subdir cfg) ".pi" "agent")
            target (fs/path target-dir file-name)]
        (if (fs/exists? source)
          (do
            (println "+ cp" (sh-quote source) (str (sh-quote target-dir) "/"))
            (when-not (:dry-run? cfg)
              (fs/copy source target {:replace-existing true})))
          (println "# skipping missing" (str source)))))

    (defn prepare-home! [cfg]
      (let [agent-dir (fs/path (:project-subdir cfg) ".pi" "agent")]
        (println "+ mkdir -p" (sh-quote agent-dir))
        (when-not (:dry-run? cfg)
          (fs/create-dirs agent-dir))
        (copy-agent-file! cfg "auth.json")
        (copy-agent-file! cfg "settings.json")))

    (defn docker-run-command [cfg]
      (let [base ["docker" "run" "--rm" "-it"
                  "-h" (:name cfg)
                  "-v" (str (:project-subdir cfg) ":" (:workdir cfg))
                  "-w" (:workdir cfg)]
            raw (:docker-run-args cfg)
            extra (:docker-run-arg cfg)
            command (:command cfg)]
        (str (printable-command base)
             (when-not (blankish? raw) (str " " raw))
             (when (seq extra) (str " " (printable-command extra)))
             " " (sh-quote (:image-ref cfg))
             (when (seq command) (str " " (printable-command command))))))

    (defn shell! [cfg]
      (when-not (:skip-build? cfg)
        (build! cfg))
      (prepare-home! cfg)
      (run-shell! cfg (docker-run-command cfg)))

    (defn printable-value [value]
      (cond
        (nil? value) ""
        (sequential? value) (printable-command value)
        :else (str value)))

    (defn print-config! [cfg]
      (doseq [key [:image-ref :node-major :no-cache? :user-id :group-id :project-dir :workdir
                   :prefix :name :project-subdir :docker-run-args :docker-run-arg
                   :command :skip-build? :dry-run?]]
        (println (format "%-22s %s" (name key) (printable-value (get cfg key))))))

    (defn list-homes! [cfg]
      (let [root (fs/path (:project-dir cfg) (:prefix cfg))]
        (if (fs/exists? root)
          (doseq [path (sort (fs/list-dir root))]
            (when (fs/directory? path)
              (println path)))
          (println (str root " (missing)")))))

    (defn delete-tree! [cfg path]
      (println "+ rm -rf" (sh-quote path))
      (when-not (:dry-run? cfg)
        (when (fs/exists? path)
          (fs/delete-tree path))))

    (defn clean! [cfg]
      (cond
        (:project-subdir-explicit? cfg)
        (delete-tree! cfg (:project-subdir cfg))

        (:all? cfg)
        (delete-tree! cfg (fs/path (:project-dir cfg) (:prefix cfg)))

        :else
        (do
          (println "Refusing to clean a freshly generated random home name.")
          (println "Use `bb clean --all` to remove all generated homes, or pass --project-subdir PATH.")
          (System/exit 1))))

    (defn show-tasks! []
      (p/shell "bb" "tasks")))

  default {:doc "Show available tasks"
           :task (show-tasks!)}

  build {:doc "Build the Docker image"
         :task (build! (config *command-line-args*))}

  shell {:doc "Build the image, create a random mounted home, then open bash"
         :task (shell! (config *command-line-args*))}

  config {:doc "Print resolved Docker/build configuration"
          :task (print-config! (config *command-line-args*))}

  options {:doc "Print supported CLI options and env vars"
           :task (config ["--help"])}

  homes {:doc "List generated home directories"
         :task (list-homes! (config *command-line-args*))}

  clean {:doc "Delete generated homes; use --all or --project-subdir PATH"
         :task (clean! (config *command-line-args*))}}}
